# ---------------------------------------------------------------------------
# Maison API environment
# Copy this file to .env and fill in the values you need.
# ---------------------------------------------------------------------------

# Port used by the local dev server (ignored on Vercel/Netlify)
PORT=4000

# MongoDB Atlas connection string.
# Leave blank to run with the in-memory demo store (great for local testing,
# but data is lost when the process restarts and is NOT persisted on Vercel).
# Example: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/maison?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to sign admin login tokens. Use a long random string in production.
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Credentials for the first admin account (used when the database is seeded)
ADMIN_NAME=Tanjina Irin
ADMIN_EMAIL=tanjinairin62@gmail.com
ADMIN_PASSWORD=tanjina1234

# Comma-separated list of allowed browser origins.
# Use * to allow every origin (not recommended for production).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Set to "false" to stop the API from seeding demo data on first boot.
SEED_ON_START=true
